# Copy to server/.env and fill in real values.

NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/trymate

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# The React app's origin (CORS allows only this)
CLIENT_URL=http://localhost:5173

# The AI service (the real one, or server/mocks/aiMock.js once Phase 3 adds it)
AI_SERVICE_URL=http://localhost:8000
# Must equal SERVICE_API_KEY in the AI service's .env
AI_SERVICE_KEY=change-me
# mock | real
AI_MODE=mock
