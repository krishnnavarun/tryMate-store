# Settings for Docker Compose only: copy to .env (docker-compose.yml reads it automatically).
# Running without Docker (npm run dev) uses server/.env and client/.env instead.

# Long random strings. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
AI_SERVICE_KEY=

# mock = the fake AI built into the server (nothing else needed)
# real = the tryMate-Ai container: docker compose --profile ai up --build -d
AI_MODE=mock

# The store opens at http://localhost:8080
WEB_PORT=8080

# Only used with --profile ai
TRYON_MOCK=true
REPLICATE_API_TOKEN=
# Where the tryMate-Ai repo is, relative to this folder
AI_SERVICE_DIR=../tryMate-Ai
